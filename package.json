{
  "name": "bia-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && cp public/robots.txt dist/robots.txt && cp public/redirect_index.html dist/index.html",
    "preview": "astro preview",
    "astro": "astro",
    "prod": "NODE_ENV=production PORT=8080 HOST=0.0.0.0 node dist/bioimage-archive/server/entry.mjs",
    "local": "astro check && astro build && astro preview",
    "test": "node --test tests/formatting/*.test.mjs",
    "audit:dead-code": "node scripts/dead-code/audit.mjs",
    "audit:dead-code:knip": "knip --config configs/quality/knip.json --reporter json",
    "test:dead-code": "node --test scripts/dead-code/*.test.mjs && node scripts/dead-code/verify-tools.mjs",
    "quality:check": "astro check --tsconfig configs/quality/tsconfig.check.json"
  },
  "dependencies": {
    "@astrojs/check": "^0.2.1",
    "@astrojs/mdx": "^4.0.2",
    "@astrojs/netlify": "^6.4.0",
    "@astrojs/node": "^9.2.2",
    "astro": "^5.0",
    "datatables.net": "^2.1.0",
    "datatables.net-dt": "^2.1.0",
    "jquery": "^3.7.1",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@astrojs/compiler": "2.12.2",
    "@rollup/plugin-yaml": "^4.1.2",
    "@types/datatables.net": "^1.10.28",
    "@types/jquery": "^3.5.29",
    "@types/node": "^20.11.24",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.3.1",
    "knip": "5.70.1",
    "typescript-eslint": "8.48.1"
  }
}
