---
import DatasetInfo from "../../../src/components/DatasetInfo.astro";
import DatasetDetail from "../../../src/components/DatasetDetail.astro";
import fieldMap from "../../../src/data/metadata-field-name-mapping.json";
import { testCases, imageRecord, deepFreeze } from "./dataset-metadata.mjs";
import studyResponse from "../../fixtures/api/study-s-biad3335-response.json";
import otherStudyResponse from "../../fixtures/api/study-s-biad3397-response.json";
import imageResponse from "../../fixtures/api/image-001b8ef2-7a5e-4b94-b91c-d93f5095ee39-response.json";

const studies = [
    studyResponse.hits.hits.find(hit => hit._source.accession_id === "S-BIAD3335")._source,
    otherStudyResponse.hits.hits.find(hit => hit._source.accession_id === "S-BIAD3397")._source,
];
const image = imageResponse.hits.hits.find(hit => hit._source.uuid === "001b8ef2-7a5e-4b94-b91c-d93f5095ee39")._source;
const repeatedDataset = testCases.find(entry => entry.id === "repeated").dataset;
const inputs = [testCases, imageRecord, studyResponse, otherStudyResponse, imageResponse];
const before = JSON.stringify(inputs);
inputs.forEach(deepFreeze);
---
<!doctype html>
<html lang="en">
    <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Dataset metadata regression fixture</title></head>
    <body>
        <h1>Dataset metadata</h1>
        <h2>Datasets</h2>
        {testCases.map(({ id, ...props }) => <article id={id}><DatasetInfo {...props} /></article>)}
        <article id="image"><DatasetDetail data={imageRecord} fieldMap={fieldMap.image_acquisition} /></article>
        {studies.map(study => (
            <article id={`api-${study.accession_id}`}>
                {study.dataset.map(dataset => (
                    <div data-fixture-dataset-uuid={dataset.uuid}><DatasetInfo dataset={dataset} /></div>
                ))}
            </article>
        ))}
        <article id="api-image">
            {image.creation_process.acquisition_process.map(record => (
                <DatasetDetail data={record} fieldMap={fieldMap.image_acquisition} />
            ))}
        </article>
        <article id="many">
            {Array.from({ length: 50 }, (_, index) => (
                <DatasetInfo dataset={deepFreeze({ ...repeatedDataset, uuid: `load-${index}`, description: `Dataset occurrence ${index}` })} />
            ))}
        </article>
        {JSON.stringify(inputs) !== before && (() => { throw new Error("Metadata render mutated source data"); })()}
    </body>
</html>
