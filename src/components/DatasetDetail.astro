---
import external_link from "../assets/bioimage-archive/external-link-svgrepo-com.png";
import { renderMetadataValue } from "./formatting/metadata-values.js";

const { data, fieldMap } = Astro.props;
const fields = Object.keys(fieldMap).filter(key => data[key] != null && (!Array.isArray(data[key]) || data[key].length > 0));
const defaultOpen = "default_open" in data ? data.default_open : true;
const initiallyOpen = Boolean(defaultOpen) && defaultOpen !== "False" && defaultOpen !== "false";
---

<details open={initiallyOpen} style="margin-bottom: 0.5rem;">
    <summary><b>{data.title}</b> {!initiallyOpen ? '(as above)' : ''}</summary>
    <div class="metadata-fields">
        {fields.map(key => (
            <div style="overflow-wrap: anywhere;">
                <b>{fieldMap[key]}:</b>&nbsp; <Fragment set:html={renderMetadataValue(key, data[key], external_link.src)} />
            </div>
        ))}
    </div>
</details>

<style>
    .metadata-fields { padding-left: 20px; }
</style>
