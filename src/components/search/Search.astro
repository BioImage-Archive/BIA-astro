---
import "../../styles/search.css";
import StudyCard from '../../components/cards/BrowseStudyCard.astro';
import ImageCard from '../../components/cards/BrowseImageCard.astro';
import SearchFacet from './SearchFacet.astro';
import SearchSelectedFacet from './SearchSelectedFacet.astro';
import PaginationControl from '../PaginationControl.astro';
import  "../../styles/toggle.css"
import "../../styles/browse_controls.css"
import "../../styles/filter_cards.css"
import { generateParamString } from "../SharedJSFunctions.js"
import {type SelectedFacets, type SearchHits, type FacetData, type PaginationData} from "./SearchInterface.astro"
import SearchResultsTable  from "./SearchResultsTable.astro"
import SearchResultsCompactCards  from "./SearchCompactCards.astro"
import { PUBLIC_SEARCH_API } from "astro:env/client";

const { url, query, searchType} =
  Astro.props as {
    url: URL;
    query: string;
    searchType: string;
  };

const searchEndpoint = searchType === "study"? `${PUBLIC_SEARCH_API}/website/browse/study`: `${PUBLIC_SEARCH_API}/website/browse/image`;
const searchPageURL = searchType === "study"? "/bioimage-archive/studies": "/bioimage-archive/images";
const hasSortParam = url.searchParams.has("sort_by") || url.searchParams.has("sort_order") || url.searchParams.has("sortBy") || url.searchParams.has("sortOrder");
const hasPageSizeParam = url.searchParams.has("pagination.page_size");
const hasSearchQuery = query !== undefined && query !== null && query !== "";
const releaseDateSortField = searchType === "image" ? "study_release_date" : "release_date";
const requestedSortBy = url.searchParams.get("sort_by") || url.searchParams.get("sortBy") || "relevance";
const requestedSortOrder = url.searchParams.get("sort_order") || url.searchParams.get("sortOrder") || "desc";
const requestedSortSource = url.searchParams.get("sort_source") || "";
const normalizedSortBy =
  requestedSortBy === "accession"
    ? "accession_id"
    : requestedSortBy === "release_date" || requestedSortBy === "study_release_date"
      ? releaseDateSortField
      : requestedSortBy;
const sortBy = ["relevance", "accession_id", releaseDateSortField].includes(normalizedSortBy) ? normalizedSortBy : "relevance";
const normalizedSortOrder = requestedSortOrder === "ascending" ? "asc" : requestedSortOrder === "descending" ? "desc" : requestedSortOrder;
const sortOrder = ["asc", "desc"].includes(normalizedSortOrder) ? normalizedSortOrder : "desc";
const page = Number(url.searchParams.get('pagination.page')) || 1;
const pageSize = Number(url.searchParams.get('pagination.page_size')) || 12;
const cursor = url.searchParams.get('cursor');
const maxResultWindow = 10000;
const cappedPage = Math.max(1, Math.floor(maxResultWindow / pageSize));
const displayPage = cursor ? Math.max(cappedPage + 1, page) : page;

function getFacetQueryValues(paramName: string) {
  const directValues = url.searchParams.getAll(paramName);
  if (directValues.length > 0) {
    return directValues;
  }

  return url.searchParams.getAll(`${paramName}.eq`);
}

const selectedFacets: SelectedFacets = {
  "facet.organism": getFacetQueryValues("facet.organism"),
  "facet.imaging_method": getFacetQueryValues("facet.imaging_method"),
  "facet.year": getFacetQueryValues("facet.year"),
  "facet.annotation_method": getFacetQueryValues("facet.annotation_method"),
  "has_converted_image": getFacetQueryValues("has_converted_image"),
  "facet.image_format": getFacetQueryValues("facet.image_format"),
  "facet.licence": getFacetQueryValues("facet.licence"),
  "facet.file_type": getFacetQueryValues("facet.file_type"),
  "size_c": getFacetQueryValues("size_c"),
  "total_size_in_bytes": getFacetQueryValues("total_size_in_bytes"),
  "size_x": getFacetQueryValues("size_x"),
  "size_y": getFacetQueryValues("size_y"),
  "size_z": getFacetQueryValues("size_z"),
  "size_t": getFacetQueryValues("size_t"),
  "total_physical_size_x": getFacetQueryValues("total_physical_size_x"),
  "total_physical_size_y": getFacetQueryValues("total_physical_size_y"),
  "total_physical_size_z": getFacetQueryValues("total_physical_size_z"),
  "image_pixel_z": getFacetQueryValues("image_pixel_z"),
  "voxel_physical_size_z": getFacetQueryValues("voxel_physical_size_z"),
  "voxel_physical_size_y": getFacetQueryValues("voxel_physical_size_y"),
  "voxel_physical_size_x": getFacetQueryValues("voxel_physical_size_x"),
};

const hasSelectedFilters = Object.values(selectedFacets).some((values) => values?.length > 0);
const isUserSelectedSort = requestedSortSource === "user" || (hasSortParam && sortBy !== "relevance");
const shouldApplySort = hasSortParam || hasSearchQuery;
const shouldKeepSort = shouldApplySort && (isUserSelectedSort || hasSearchQuery || hasSelectedFilters);
const sortSource = isUserSelectedSort ? "user" : "query";

const FACET_CONFIG: Record<
  string,
  { title: string; type: "terms" | "range" | "slider" | "boolean"; queryKey?: string; field?: string }
> = {
  scientific_name: { title: "Organism", type: "terms", queryKey: "facet.organism" },
  imaging_method: { title: "Imaging Method", type: "terms", queryKey: "facet.imaging_method" },
  release_date: { title: "Release Year", type: "terms", queryKey: "facet.year" },
  annotation_method: { title: "Annotation Method", type: "terms", queryKey: "facet.annotation_method" },
  image_format: { title: "Image Format", type: "terms", queryKey: "facet.image_format" },
  number_of_channels: { title: "Channels", type: "terms", queryKey: "size_c" },
  licence: {title: "Licence", type:"terms", queryKey: "facet.licence"},
  file_type: { title: "File Type", type: "terms", queryKey: "facet.file_type" },

  image_pixel_z: { title: "Z-Planes", type: "terms", queryKey: "size_z" },
  image_pixel_x: { title: "Image Pixel X (px)", type: "terms", queryKey: "size_x" },
  image_pixel_y: { title: "Image Pixel Y (px)", type: "terms", queryKey: "size_y" },
  time_steps: { title: "Time Steps", type: "terms", queryKey: "size_t" },
  total_size_in_bytes: { title: "Total Size (bytes)", type: "terms", queryKey: "total_size_in_bytes" },
  total_physical_size_x: { title: "Total Physical Size X (m)", type: "terms", queryKey: "total_physical_size_x" },
  total_physical_size_y: { title: "Total Physical Size Y (m)", type: "terms", queryKey: "total_physical_size_y" },
  total_physical_size_z: { title: "Total Physical Size Z (m)", type: "terms", queryKey: "total_physical_size_z" },
  voxel_physical_size_x: { title: "Voxel Physical Size X (m/px)", type: "terms", queryKey: "voxel_physical_size_x" },
  voxel_physical_size_y: { title: "Voxel Physical Size Y (m/px)", type: "terms", queryKey: "voxel_physical_size_y" },
  voxel_physical_size_z: { title: "Voxel Physical Size Z (m/px)", type: "terms", queryKey: "voxel_physical_size_z" },
};

let hits = {} as SearchHits;
let facetData = {} as FacetData;
let paginationData = {} as PaginationData;

const hasQueryParam = query || query ==="";
if (hasQueryParam) {
  const searchURL = generateParamString(
    searchEndpoint,
    query,
    page,
    selectedFacets,
    pageSize,
    shouldKeepSort ? sortBy : "",
    shouldKeepSort ? sortOrder : "",
    sortSource
  );

  const requestURL = new URL(searchURL, "http://local");
  if (cursor) {
    requestURL.searchParams.set("cursor", cursor);
    requestURL.searchParams.delete("pagination.page");
  }

  const res = await fetch(requestURL.toString());
  if (res.ok) {
    const data = await res.json();
    hits = data.hits;
    facetData = data.facets;
    paginationData = data.pagination;
  }
}


const totalResults = hits?.total?.value ?? 0;
let results = hits.hits;

function parseAccession(id: unknown): [string, number] {
  const match = String(id ?? "").match(/^([A-Z\-]+)(\d+)$/i);
  if (!match) return [String(id ?? ""), 0];
  return [match[1], parseInt(match[2], 10)];
}

function sortAccession(aId: unknown, bId: unknown, sortOrder: string) {
  const [aPrefix, aNum] = parseAccession(aId);
  const [bPrefix, bNum] = parseAccession(bId);
  const prefixCompare = aPrefix.localeCompare(bPrefix);
  if (prefixCompare !== 0) return sortOrder === "desc" ? -prefixCompare : prefixCompare;
  return sortOrder === "desc" ? bNum - aNum : aNum - bNum;
}

function sortReleaseDate(aReleaseDate: unknown, bReleaseDate: unknown, sortOrder: string) {
  const aTime = new Date(String(aReleaseDate ?? "")).getTime() || 0;
  const bTime = new Date(String(bReleaseDate ?? "")).getTime() || 0;
  return sortOrder === "desc" ? bTime - aTime : aTime - bTime;
}

if (Array.isArray(results)) {
  switch(sortBy) {
    case "accession_id":
      results = results.slice().sort((a, b) => sortAccession(a?._source?.accession_id, b?._source?.accession_id, sortOrder));
      break;
    case "release_date":
    case "study_release_date":
      results = results.slice().sort((a, b) => sortReleaseDate(a?._source?.[releaseDateSortField], b?._source?.[releaseDateSortField], sortOrder));
      break;
    default:
      results = results.slice();
      break;
  }
}

function hasBuckets(x: any): x is FacetData {
  return !!x && Array.isArray(x.buckets);
}

function hasMinMax(x: any): x is { min: number; max: number; globalMin: number; globalMax: number; globalCount: number } {
  return !!x && typeof x.globalMin === "number" && typeof x.globalMax === "number";
}


const facets = Object.entries(facetData).reduce((acc, [facetKey, data]) => {
  const cfg = FACET_CONFIG[facetKey];
  if (!cfg) return acc;

  // TERMS FACETS (buckets)
  if (cfg.type === "terms" || cfg.type === "boolean") {
    if (!hasBuckets(data)) return acc;

    let valuesAndCounts = data.buckets
      .slice()
      .sort((a, b) => {
        const aKey = (a.key_as_string ?? a.key ?? "").toString().toLowerCase();
        const bKey = (b.key_as_string ?? b.key ?? "").toString().toLowerCase();
        return aKey.localeCompare(bKey);
      })
      .reduce((obj, bucket) => {
        const k = (bucket.key_as_string ?? bucket.key ?? "").toString();
        obj[k] = bucket.doc_count;
        return obj;
      }, {} as Record<string, number>);
    
    // restore backend order
    //   reduce above also causes 2048 to be misplaced so re-apply order
    if([
      "total_size_in_bytes",
      "time_steps",
      "total_physical_size_x",
      "total_physical_size_y",
      "total_physical_size_z",
      "voxel_physical_size_x",
      "voxel_physical_size_y",
      "voxel_physical_size_z",
      "image_pixel_z",
      "image_pixel_x",
      "image_pixel_y",
    ].includes(facetKey)) {
      const preservedOrderValuesAndCounts = {};
      data.buckets.map((bucket) => {
        // space needed so 2048 isn't a numeric key, which would cause it to be the first key in the dictionary, independent of insertion order
        preservedOrderValuesAndCounts[" " + bucket.key] = bucket.doc_count;
      });
      valuesAndCounts = preservedOrderValuesAndCounts;
    };

    const totalFacetCounts =
      Object.keys(valuesAndCounts).length + (data.sum_other_doc_count ?? 0);

    acc[cfg.queryKey!] = {
      kind: cfg.type,
      valuesAndCounts,
      selectedValue: selectedFacets[cfg.queryKey!] ?? [],
      totalFacetCounts,
      title: cfg.title,
    };

    return acc;
  }

  // RANGE FACETS (min/max)
  if (cfg.type === "range" || cfg.type === "slider") {
    if (!hasMinMax(data)) return acc;

    const gteKey = `${cfg.field}.gte`;
    const lteKey = `${cfg.field}.lte`;

    acc[cfg.field!] = {
      kind: cfg.type,
      title: cfg.title,
      field: cfg.field,
      min: data.min,
      max: data.max,
      globalMin: data.globalMin,
      globalMax: data.globalMax,
      globalCount: data.globalCount,
      selectedMin: selectedFacets[gteKey]?.[0] ?? "",
      selectedMax: selectedFacets[lteKey]?.[0] ?? "",
      gteKey,
      lteKey,
    };

    return acc;
  }

}, {} as Record<string, any>);
---
<script src="./search-results.js"></script>
<section
  id="search-results-shell"
  class="vf-content | vf-u-grid-example | vf-grid vf-grid__col-5"
  data-total-results={String(totalResults)}
  data-page-size={String(pageSize)}
  data-results-count={String(results?.length ?? 0)}
  data-capped-page={String(cappedPage)}
  data-current-page={String(displayPage)}
  data-display-page={String(displayPage)}
  data-has-cursor={cursor ? "true" : "false"}
>
  <div class="vf-u-grid__col--span-3--sm vf-u-grid__col--span-1--lg vf-u-grid__col--span-1--xl">
    <br />
    <div style="display: flex;">        
      <div style="padding-top: 0.4em">
      <svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="0 0 16 16">
        <rect width="16" height="16" fill="none" />
        <path fill="currentColor" d="M6 4a1 1 0 1 1-2 0a1 1 0 0 1 2 0M2 4a3 3 0 0 1 3-3h6a3 3 0 1 1 0 6H5a3 3 
          0 0 1-3-3m3-2a2 2 0 1 0 0 4h6a2 2 0 1 0 0-4zm6 10a1 1 0 1 0 0-2a1 1 0 0 0 0 2m-9-1a3 3 0 0 1 3-3h6a3 
          3 0 1 1 0 6H5a3 3 0 0 1-3-3m3-2a2 2 0 1 0 0 4h6a2 2 0 1 0 0-4z" />
        </svg> 
      </div>
      <div><h3> Filter by</h3></div>
    </div>
    <div>
      <form id="facets" method="GET" action={searchPageURL} class="vf-form">
        {Object.entries(facets).map(([id, facet]) => <>
        <SearchFacet facet={facet} id={id} />
        </>
        )}
        <input type="hidden" name="query" value={query}  />
        {url.searchParams.has("pagination.page_size") && (
          <input type="hidden" name="pagination.page_size" value={String(pageSize)} />
        )}
        {shouldKeepSort && (
          <>
            <input type="hidden" name="sort_by" value={sortBy} />
            <input type="hidden" name="sort_order" value={sortOrder} />
            <input type="hidden" name="sort_source" value={sortSource} />
          </>
        )}
        <input
          type="hidden"
          id="has_converted_image_hidden"
          name="has_converted_image"
          value="true"
          disabled={!url.searchParams.has("has_converted_image")}
        />        
      </form>
    </div>
  </div>
  <div class="vf-u-grid__col--span-1--sm  vf-u-grid__col--span-2--md vf-u-grid__col--span-4--lg vf-u-grid__col--span-4--xl" style="min-width:50%">
    { (hasQueryParam) && (
        <section class="vf-content">
          <div class="vf-grid vf-grid__col-3">
            <div class="vf-grid__col--span-2">{query && (<h2>Search results for <a href={`${searchPageURL}?query=${query}`}><strong>{query}</strong></a></h2>)}</div>
            <div></div>
          </div>
          <section class="vf-content">
            <div class="results-header">
              <div class="results-count">
                <span id="paginated-results">
                    {results !== undefined && results?.length != 0 && totalResults > 0 && `${(Math.max(1, displayPage) - 1) * paginationData.page_size + 1} - ${Math.min(((Math.max(1, displayPage) - 1) * paginationData.page_size) + results.length, totalResults)} of ${totalResults} results`}
                  </span>
                </div>
                <div class="vf-form" id="resultsToolbar">
                  { searchType === "study"? (
                      <div class="converted-study-switch">
                        <span> Studies with viewable images:  </span>
                        <label class="switch">
                          <input type="checkbox" id="convertedImageToggle">
                          <span class="slider round"></span>
                        </label>
                      </div>
                    ) : (
                      <div class="converted-image-switch">
                        <span> Viewable Images:  </span>
                        <label class="switch">
                          <input type="checkbox" id="convertedImageToggle">
                          <span class="slider round"></span>
                        </label>
                      </div>

                    )
                  }
                  <div class="controls-container">
                    <div class="controls-inner">
                      <div class="toggle-switch">
                        <label class="toggle-option">
                            <input type="radio" name="view" value="card-view" checked>
                            <span class="toggle-label">Cards</span>
                        </label>
                        <label class="toggle-option">
                            <input type="radio" name="view" value="table-view">
                            <span class="toggle-label">Table</span>
                        </label>
                        <label class="toggle-option">
                            <input type="radio" name="view" value="grid-view">
                            <span class="toggle-label">Grid</span>
                        </label>
                      </div>
                    </div>
                  </div>
                  <div class="toolbar-selects">
                    <select name="pageSize" id="pageSize" class="toolbar-select vf-u-type__text-body--5" aria-label="Page size">
                      <option value="12" selected={!hasPageSizeParam || pageSize === 12}>Page size</option>
                      <option value="30" selected={pageSize === 30}>30 per page</option>
                      <option value="60" selected={pageSize === 60}>60 per page</option>
                      <option value="90" selected={pageSize === 90}>90 per page</option>
                    </select>
                    <select name="sort_by" id="sortBy" class="toolbar-select vf-u-type__text-body--5" aria-label="Sort by">
                      <option value="" selected={!shouldKeepSort}>Sort by</option>
                      <option value="relevance" selected={shouldKeepSort && sortBy === "relevance"}>Relevance</option>
                      <option value={releaseDateSortField} selected={shouldKeepSort && sortBy === releaseDateSortField}>Release date</option>
                      <option value="accession_id" selected={shouldKeepSort && sortBy === "accession_id"}>Accession</option>
                    </select>
                    <select name="sort_order" id="sortOrder" class="toolbar-select vf-u-type__text-body--5" aria-label="Sort order">
                      <option value="" selected={!shouldKeepSort}>Sort order</option>
                      <option value="desc" selected={shouldKeepSort && sortOrder === "desc"}>Descending</option>
                      <option value="asc" selected={shouldKeepSort && sortOrder === "asc"}>Ascending</option>
                    </select>
                  </div>
                </div>
            </div>
            <div id="selected-facets" style="margin-top: 0.5rem; align-items: center;">
              <SearchSelectedFacet query={query} url={searchPageURL} text="Query" kind="query" pageSize={pageSize} selectedFacets={selectedFacets} sortBy={shouldKeepSort ? sortBy : ""} sortOrder={shouldKeepSort ? sortOrder : ""} sortSource={sortSource} />
              {Object.entries(facets).map(([facetKey, facet]) => (
                <SearchSelectedFacet
                  key={facetKey}
                  selectedList={facet.selectedValue}
                  url={searchPageURL}
                  text={facet.title}
                  query={query}
                  selectedFacets={selectedFacets}
                  kind={facet.kind}
                  minVal={facet?.selectedMin || ""} 
                  maxVal={facet?.selectedMax || ""}
                  pageSize={pageSize}
                  sortBy={shouldKeepSort ? sortBy : ""}
                  sortOrder={shouldKeepSort ? sortOrder : ""}
                  sortSource={sortSource}
                />
              ))}
            </div>
            <div id="card-view">
            <div class="vf-card-container vf-card-container__col-4 vf-u-fullbleed"  style="--vf-card__image--aspect-ratio: 16 / 9; --vf-card-container__inner--grid-gap: 0.5rem;">
              <div class="vf-card-container__inner">
              {results === undefined || results.length === 0 ? (
                <p>No results found.</p>
              ) : (
                results?.map((item) => (
                  searchType === "study"? (<StudyCard study={item._source} highlight={item.highlight} query={query} studyPageRoot="study" />):
                  (<ImageCard image={item._source} highlight={item.highlight} query={query} imagePageRoot="image" />)
                  
                ))
              )}
              </div>
            </div>
            </div>
            <div id="table-view" style="display: none;">
              {
                results === undefined || results.length === 0 ? <p>No results found.</p> 
                  : <SearchResultsTable results={results} resultType={searchType} query={query}/>
              }
            </div>
            <div id="grid-view" style="display: none;">
              <div class="column-toggle-container">
                <div class="column-toggle">
                    <label class="column-option">
                        <input type="radio" name="columns" value="3">
                        <span class="column-label">3 Columns</span>
                    </label>
                    <label class="column-option">
                        <input type="radio" name="columns" value="4" checked>
                        <span class="column-label">4 Columns</span>
                    </label>
                    <label class="column-option">
                        <input type="radio" name="columns" value="5">
                        <span class="column-label">5 Columns</span>
                    </label>
                </div>
              </div>
              <section class="grid-container">
                  <div class="grid-inner">
                    {results === undefined || results.length === 0 ? (
                      <p>No results found.</p>
                    ) : (
                      results?.map((item) => (
                        <SearchResultsCompactCards result={item._source} resultType={searchType} highlight={item.highlight}/>
                      ))
                    )}
                  </div>
              </section>
            </div>
            {results === undefined || results?.length != 0 && (<br/><PaginationControl  paginationData={paginationData} displayPage={displayPage}/>)}
          </section>
        </section>
      )
    }
  </div>
</section>
