---
import onlineImage from '../assets/bioimage-archive/online_tutorial_image.png';
import paperImage from '../assets/bioimage-archive/BioImage_Archive_paper.png';
import EMPIARpaperImage from '../assets/bioimage-archive/EMPIAR_paper.png';
import EMDBbrowse from '../assets/bioimage-archive/EMDB_browse.png'
import { getTutorialURLs } from './SharedJSFunctions';

export const tutorial_url = getTutorialURLs("quick-tour");
---

<div class="right-menu">
  <h3>Further information</h3>
  <a class="right-menu-image-link" href={tutorial_url}>
      <img class="padding-bottom-large" src={onlineImage.src} alt="BioImage Archive Online Tutorial" width="250px"/>
  </a>
  <hr/>
  <a class="right-menu-image-link" href="https://doi.org/10.1016/j.jmb.2022.167505">
    <img class="padding-bottom-large" src={paperImage.src} alt="The BioImage Archive paper" width="200px" />
  </a>
  <p> The paper describing the BioImage Archive  <a href="https://doi.org/10.1016/j.jmb.2022.167505" target="_blank"> Read more </a>
  </p>
  <hr/>
  <a class="right-menu-image-link" href="https://doi.org/10.1093/nar/gkac1062">
    <img class="padding-bottom-large" src={EMPIARpaperImage.src} alt="EMPIAR paper" width="240px" />
  </a>
  <p> Paper about EMPIAR  <a href="https://doi.org/10.1093/nar/gkac1062" target="_blank"> Read more </a>
  </p>
  <hr/>    
  <a class="right-menu-image-link" href="https://www.nature.com/articles/s41592-018-0195-8">
        <img class="padding-bottom-large" src="https://pbs.twimg.com/media/Dq2cvhHXcAE1YoK.jpg" alt="A call for public archives for biological image data" width="240px" />
    </a>
    <p> A paper detailing the need for the BioImage Archive was featured in Nature Methods in November 2018. <a href="https://www.nature.com/articles/s41592-018-0195-8" target="_blank"> Read more</a>
    </p>
</div>

<style>
  .right-menu-image-link {
    display: block;
    text-align: center;
  }
</style>
