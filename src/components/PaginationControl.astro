---
const { paginationData, displayPage: displayPageProp } = Astro.props;
const current_page = paginationData.page;
const total_pages = paginationData.total_pages;
const page_size = paginationData.page_size;
const next_cursor = paginationData.next_cursor;
const url = new URL(Astro.request.url);
const current_cursor = url.searchParams.get("cursor");
const max_result_window = 10000;
const max_window_page = Math.max(1, Math.floor(max_result_window / page_size));
const capped_page = Math.min(total_pages, max_window_page);
const has_cursor_pagination = total_pages > capped_page;
const display_page = Number(displayPageProp) || (current_cursor ? capped_page + 1 : (current_page || capped_page));

function buildPageURL(targetPage: number, cursor?: string | null) {
  const nextURL = new URL(Astro.request.url);
  if (cursor) {
    nextURL.searchParams.set("cursor", cursor);
    nextURL.searchParams.set("pagination.page", String(targetPage));
  } else {
    nextURL.searchParams.set("pagination.page", String(targetPage));
    nextURL.searchParams.delete("cursor");
  }
  return nextURL.toString();
}

function buildDisplayURL() {
  const nextURL = new URL(Astro.request.url);
  nextURL.searchParams.delete("pagination.page");
  nextURL.searchParams.delete("cursor");
  return nextURL.toString();
}

function addRange(target: number[], start: number, end: number) {
  for (let page = start; page <= end; page += 1) {
    target.push(page);
  }
}

const pageItems = [];
addRange(pageItems, 1, Math.min(5, capped_page));

const tailStart =
  display_page <= capped_page && display_page >= capped_page - 2
    ? Math.max(6, capped_page - 2)
    : capped_page;
const middleStart = Math.max(6, display_page - 1);
const middleEnd = Math.min(capped_page - 3, display_page + 1);

if (middleStart <= middleEnd) {
  addRange(pageItems, middleStart, middleEnd);
}

if (tailStart <= capped_page) {
  addRange(pageItems, tailStart, capped_page);
}

const uniquePages = [...new Set(pageItems)].sort((a, b) => a - b);
const renderedItems: Array<number | "ellipsis"> = [];

function appendRenderedPage(page: number) {
  const previous = renderedItems.at(-1);
  if (typeof previous === "number" && page - previous > 1) {
    renderedItems.push("ellipsis");
  }
  if (previous !== page) {
    renderedItems.push(page);
  }
}

const nextPageHref =
  display_page < capped_page
    ? buildPageURL(display_page + 1)
    : next_cursor
      ? buildPageURL(display_page + 1, next_cursor)
      : null;

for (const page of uniquePages) {
  appendRenderedPage(page);
}

if (has_cursor_pagination && display_page >= capped_page) {
  if (display_page > capped_page) {
    appendRenderedPage(display_page);
  }
  if (nextPageHref && display_page + 1 <= total_pages) {
    appendRenderedPage(display_page + 1);
  }
}

const previousHref =
  current_cursor
    ? display_page - 1 <= capped_page
      ? buildPageURL(display_page - 1)
      : null
    : display_page > 1
      ? buildPageURL(display_page - 1)
      : null;

const lastRenderedPage = [...renderedItems].reverse().find((item) => typeof item === "number");
const showCursorSummary = has_cursor_pagination && total_pages > 0;
const showCursorTailEllipsis =
  showCursorSummary &&
  typeof lastRenderedPage === "number" &&
  total_pages - lastRenderedPage > 1;

---
<nav
  class="vf-pagination"
  aria-label="Pagination"
  data-total-pages={String(total_pages)}
  data-page-size={String(page_size)}
  data-capped-page={String(capped_page)}
  data-current-page={String(current_page)}
  data-display-page={String(display_page)}
  data-has-cursor={current_cursor ? "true" : "false"}
  data-current-cursor={current_cursor ?? ""}
  data-next-href={nextPageHref ?? ""}
  data-next-cursor-page={String(display_page + 1)}
>
    <ul class="vf-pagination__list | vf-list vf-list--inline" style="display: flex; flex-wrap: wrap; gap: 0.25rem;">
    <li class="vf-pagination__item vf-pagination__item--previous-page">
      {previousHref
        ? <a href={buildDisplayURL()} data-fetch-url={previousHref} data-nav-state={JSON.stringify({ page: display_page - 1 })}>Previous</a>
        : <span>Previous</span>}
    </li>
    {renderedItems.map((item) => (
      <li class={`vf-pagination__item ${item === display_page ? "vf-pagination__item--is-active" : ""}`}>
        {item === "ellipsis" ? (
          <span aria-hidden="true">...</span>
        ) : item === display_page ? (
          <span style="padding: 0.25rem 0.5rem; background-color: #3b6fb6; color: white;">{item}</span>
        ) : nextPageHref && Number(item) === display_page + 1 && Number(item) > capped_page ? (
          <a href={buildDisplayURL()} data-fetch-url={nextPageHref} data-cursor-page={String(display_page + 1)} data-nav-state={JSON.stringify({ cursorPage: display_page + 1, cursorTrail: current_cursor ? [current_cursor] : [] })}>{item}</a>
        ) : current_cursor && Number(item) === capped_page ? (
          <a href={buildDisplayURL()} data-fetch-url={buildPageURL(capped_page)} data-nav-state={JSON.stringify({ page: capped_page })}>{item}</a>
        ) : current_cursor && Number(item) < display_page && Number(item) > capped_page ? (
          ""
        ) : (
          <a href={buildDisplayURL()} data-fetch-url={buildPageURL(Number(item))} data-nav-state={JSON.stringify({ page: Number(item) })}>{item}</a>
        )}
      </li>
    ))}
    {showCursorTailEllipsis && (
      <li class="vf-pagination__item">
        <span aria-hidden="true">...</span>
      </li>
    )}
    {showCursorSummary && (
      <li class="vf-pagination__item">
        <span>out of {total_pages} pages</span>
      </li>
    )}
    <li class="vf-pagination__item vf-pagination__item--next-page">
      {nextPageHref
        ? <a href={buildDisplayURL()} data-fetch-url={nextPageHref} data-cursor-page={String(display_page + 1)} data-nav-state={JSON.stringify({ cursorPage: display_page + 1, cursorTrail: current_cursor ? [current_cursor] : [] })}>Next</a>
        : <span>Next</span>}
    </li>
    </ul>
</nav>
