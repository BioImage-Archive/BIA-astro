---
import fieldMap from "../data/metadata-field-name-mapping.json";
import DatasetDetail from "./DatasetDetail.astro";

const { dataset, datasetFileSummaryString = null } = Astro.props;
const biosampleMap = fieldMap["biosample"];
const sippMap = fieldMap["specimen_imaging_preparation_protocol"];
const sgpMap = fieldMap["specimen_growth_protocol"];
const imageAcquisitionMap = fieldMap["image_acquisition"];
const analysisMethodMap = fieldMap["analysis_method"];
const annotationMethodMap = fieldMap["annotation_method"];
const correlationMethodMap = fieldMap["correlation_method"];

const detail_section_style= "margin-bottom: 1rem;"

function getAdditionalMetadataValue(name) {
    const metadata = dataset?.additional_metadata?.find((item) => item?.name === name);
    return metadata?.value?.[name] ?? null;
}

function getFileTypeCountEntries(fileTypeCounts) {
    if (!fileTypeCounts || typeof fileTypeCounts !== "object") {
        return [];
    }

    const entries = Array.isArray(fileTypeCounts)
        ? fileTypeCounts.map((item) => [item?.file_type, item?.count])
        : Object.entries(fileTypeCounts);

    return entries
        .filter(([extension, count]) =>
            typeof extension === "string" &&
            extension.length > 0 &&
            extension !== "file" &&
            extension !== "directory" &&
            count != null &&
            Number.isFinite(Number(count))
        )
        .map(([extension, count]) => ({
            extension: extension.replace(/^\./, ""),
            count: Number(count),
        }));
}

function formatVoxelSizes(voxelSizes) {
    const voxelSize = Array.isArray(voxelSizes) ? voxelSizes[0] : voxelSizes;
    if (!voxelSize || typeof voxelSize !== "object") return null;

    const dimensions = ["x", "y", "z"].flatMap((axis) => {
        const value = voxelSize[`voxel_size_${axis}`];
        return value == null || value === "" ? [] : [{ axis, value: String(value) }];
    });
    if (dimensions.length === 0) return null;

    return {
        label: `Voxel size (${dimensions.map(({ axis }) => axis.toUpperCase()).join(" × ")})`,
        value: dimensions.map(({ value }) => value).join(" × "),
    };
}

const metadataFileTypeCounts = getAdditionalMetadataValue("file_type_counts");
const metadataFileTypeCountEntries = getFileTypeCountEntries(metadataFileTypeCounts);
const fileTypeCountEntries = metadataFileTypeCountEntries.length > 0
    ? metadataFileTypeCountEntries
    : getFileTypeCountEntries(dataset?.file_type_counts);
const formattedFileTypeCounts = fileTypeCountEntries
    .map(({ extension, count }) => `${extension} (${count})`)
    .join(", ");
const hasMetadataFileTypeCounts = metadataFileTypeCountEntries.length > 0;
const metadataVoxelSize = formatVoxelSizes(getAdditionalMetadataValue("voxel_sizes"));
const voxelSize = metadataVoxelSize ?? (dataset?.physical_voxel_size
    ? { label: "Physical Voxel Size", value: dataset.physical_voxel_size }
    : null);
const totalFileTypeCount = fileTypeCountEntries.length > 0
    ? fileTypeCountEntries.reduce((total, { count }) => total + count, 0)
    : null;
const dsFromFileList = datasetFileSummaryString?.datasets?.find((ds) => ds.dataset == dataset.title) ?? null;
const fileCountsFromFileList = dsFromFileList?.file_count ?? null;
const fileCount = totalFileTypeCount ?? fileCountsFromFileList ?? dataset?.image_count ?? null;
const formatsFromFileList = dsFromFileList
    ? [
        dsFromFileList.data_format ? `${dsFromFileList.data_format}` : "",
    ].filter(Boolean).join(", ") || Object.entries(dsFromFileList?.formats || {}).map( k => `${k[1]} ${k[0]} file(s)`).join(", ")
    : null;
const fileFormatsLabel = hasMetadataFileTypeCounts
    ? "File types and counts"
    : formatsFromFileList
      ? "File formats"
      : "Top 5 file formats";
const fileFormats = hasMetadataFileTypeCounts
    ? formattedFileTypeCounts
    : formatsFromFileList || formattedFileTypeCounts;
---
<style>
    .details > div{
        padding-left: 20px
    }
</style>

<div style="margin-bottom: 1rem;">
    
    <div>
        <b style="font-size: 14pt;">{dataset.title}</b>
    </div>
    <div class="details">

        <div style={detail_section_style}>
            <b>Description:</b>&nbsp;{dataset.description}
        </div>
        {
            voxelSize && (
                <div style={detail_section_style}>
                    <b>{voxelSize.label}:</b>&nbsp;{voxelSize.value}
                </div>
            )
        }
        <div style={detail_section_style}>
            <b>Number of images/files:</b>&nbsp;{fileCount ?? "Not reported"}
        </div>
        {
            (formattedFileTypeCounts || formatsFromFileList) && (
                <div style={detail_section_style}>
                    <b>{fileFormatsLabel}:</b>&nbsp;{fileFormats}
                </div>
            )
        }
        {
            "biological_entity" in dataset &&
                dataset.biological_entity &&
                dataset.biological_entity.length > 0 && (
                    <div class="details">
                        <b>Biosamples:</b>
                        <div style={detail_section_style}>
                            {dataset.biological_entity.map((biosample) => (
                                <DatasetDetail
                                    data={biosample}
                                    fieldMap={biosampleMap}
                                />
                            ))}
                        </div>
                    </div>
                )
        }
        {
            "specimen_imaging_preparation_protocol" in dataset &&
                dataset.specimen_imaging_preparation_protocol &&
                dataset.specimen_imaging_preparation_protocol.length > 0 && (
                    <div class="details">
                        <b>Specimen Preparation Protocols:</b>
                        <div style={detail_section_style}>
                            {dataset.specimen_imaging_preparation_protocol.map(
                                (sipp) => (
                                    <DatasetDetail
                                        data={sipp}
                                        fieldMap={sippMap}
                                    />
                                ),
                            )}
                        </div>
                    </div>
                )
        }
        {
            "acquisition_process" in dataset &&
                dataset.acquisition_process &&
                dataset.acquisition_process.length > 0 && (
                    <div class="details">

                    <b>Image Acquisition Processes:</b>
                    <div style={detail_section_style}>
                        {dataset.acquisition_process.map(
                            (image_acquisition) => (
                                <DatasetDetail
                                    data={image_acquisition}
                                    fieldMap={imageAcquisitionMap}
                                />
                            ),
                        )}
                    </div>
                    </div>
                )
        }
        {
            "other_creation_process" in dataset &&
                dataset.other_creation_process &&
                dataset.other_creation_process.length > 0 && (
                                        <div class="details">

                    <b>Creation Protocols:</b>
                    <div style={detail_section_style}>
                        {dataset.other_creation_process.map(
                            (sgp) => (
                                <DatasetDetail
                                    data={sgp}
                                    fieldMap={sgpMap}
                                />
                            ),
                        )}
                    </div>
                                        </div>
                )
        }
        {
            "analysis_method" in dataset && dataset.analysis_method && dataset.analysis_method.length > 0 && (
                <div class="details">
                    <b>Image Analysis Methods:</b>
                    <div style={detail_section_style}>
                        {dataset.analysis_method.map((analysis_method) => (
                            <DatasetDetail
                                data={analysis_method}
                                fieldMap={analysisMethodMap}
                            />
                        ))}
                    </div>
                    </div>
                
            )
        }
        {
            "correlation_method" in dataset && dataset.correlation_method && dataset.correlation_method.length > 0 && (
                                    <div class="details">

                <b>Correlation Methods:</b>
                <div style={detail_section_style}>
                    {dataset.correlation_method.map((correlation_method) => (
                        <DatasetDetail
                            data={correlation_method}
                            fieldMap={correlationMethodMap}
                        />
                    ))}
                </div>
                                    </div>
            )
        }
        {
            "annotation_process" in dataset && dataset.annotation_process && dataset.annotation_process.length > 0 && (
                                    <div class="details">

                <b>Annotation Methods:</b>
                <div style={detail_section_style}>
                    {dataset.annotation_process.map((annotation_method) => (
                        <DatasetDetail
                            data={annotation_method}
                            fieldMap={annotationMethodMap}
                        />
                    ))}
                </div>
                </div>
            )
        }
    </div>
</div>
