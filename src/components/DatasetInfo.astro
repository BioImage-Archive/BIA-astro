---
import fieldMap from "../data/metadata-field-name-mapping.json";
import DatasetMetadataRecord from "./DatasetMetadataRecord.astro";
import { validFileCount } from "./formatting/file-counts.mjs";
import "../styles/dataset-metadata.css";

const { dataset, datasetFileSummaryString = null } = Astro.props;
const hasDescription = dataset.description != null && dataset.description !== "";

function getAdditionalMetadataValue(name) {
    const metadata = dataset?.additional_metadata?.find((item) => item?.name === name);
    return metadata?.value?.[name] ?? null;
}

function getFileTypeCountEntries(fileTypeCounts) {
    if (!fileTypeCounts || typeof fileTypeCounts !== "object") {
        return [];
    }

    const entries = Array.isArray(fileTypeCounts)
        ? fileTypeCounts.map((item) => [item?.file_type, item?.count])
        : Object.entries(fileTypeCounts);

    return entries
        .filter(([extension]) =>
            typeof extension === "string" &&
            extension.length > 0 &&
            extension !== "file" &&
            extension !== "directory"
        )
        .map(([extension, count]) => ({
            extension: extension.replace(/^\./, ""),
            count: validFileCount(count),
        }));
}

function formatVoxelSizes(voxelSizes) {
    const voxelSize = Array.isArray(voxelSizes) ? voxelSizes[0] : voxelSizes;
    if (!voxelSize || typeof voxelSize !== "object") return null;

    const dimensions = ["x", "y", "z"].flatMap((axis) => {
        const value = voxelSize[`voxel_size_${axis}`];
        return value == null || value === "" ? [] : [{ axis, value: String(value) }];
    });
    if (dimensions.length === 0) return null;

    return {
        label: `Voxel size (${dimensions.map(({ axis }) => axis.toUpperCase()).join(" × ")})`,
        value: dimensions.map(({ value }) => value).join(" × "),
    };
}

const metadataFileTypeCounts = getAdditionalMetadataValue("file_type_counts");
const metadataFileTypeCountEntries = getFileTypeCountEntries(metadataFileTypeCounts);
const hasMetadataFileTypeCounts = metadataFileTypeCountEntries.some(({ count }) => count != null);
const selectedFileTypeCountEntries = hasMetadataFileTypeCounts
    ? metadataFileTypeCountEntries
    : getFileTypeCountEntries(dataset?.file_type_counts);
const fileTypeCountEntries = selectedFileTypeCountEntries.filter(({ count }) => count != null);
const formattedFileTypeCounts = fileTypeCountEntries
    .map(({ extension, count }) => `${extension} (${count})`)
    .join(", ");
const metadataVoxelSize = formatVoxelSizes(getAdditionalMetadataValue("voxel_sizes"));
const voxelSize = metadataVoxelSize ?? (dataset?.physical_voxel_size
    ? { label: "Physical Voxel Size", value: dataset.physical_voxel_size }
    : null);
// A partial set of valid format counts cannot establish a complete file total.
const summedFileTypeCount = fileTypeCountEntries.length > 0 && selectedFileTypeCountEntries.every(({ count }) => count != null)
    ? fileTypeCountEntries.reduce((total, { count }) => total + count, 0)
    : null;
const totalFileTypeCount = validFileCount(summedFileTypeCount);
const dsFromFileList = datasetFileSummaryString?.datasets?.find((ds) => ds.dataset == dataset.title) ?? null;
const fileCountsFromFileList = dsFromFileList?.file_count ?? null;
const fileCount = totalFileTypeCount ?? validFileCount(fileCountsFromFileList) ?? validFileCount(dataset?.image_count);
const formatsFromFileList = dsFromFileList
    ? [
        dsFromFileList.data_format ? `${dsFromFileList.data_format}` : "",
    ].filter(Boolean).join(", ") || Object.entries(dsFromFileList?.formats || {}).map( k => `${k[1]} ${k[0]} file(s)`).join(", ")
    : null;
const fileFormatsLabel = hasMetadataFileTypeCounts
    ? "File types and counts"
    : formatsFromFileList
      ? "File formats"
      : "Top 5 file formats";
const fileFormats = hasMetadataFileTypeCounts
    ? formattedFileTypeCounts
    : formatsFromFileList || formattedFileTypeCounts;
const groups = [
    ["biological_entity", "biosample", "Biosamples"],
    ["specimen_imaging_preparation_protocol", "specimen_imaging_preparation_protocol", "Specimen Preparation Protocols"],
    ["acquisition_process", "image_acquisition", "Image Acquisition Processes"],
    ["other_creation_process", "specimen_growth_protocol", "Creation Protocols"],
    ["analysis_method", "analysis_method", "Image Analysis Methods"],
    ["correlation_method", "correlation_method", "Correlation Methods"],
    ["annotation_process", "annotation_method", "Annotation Methods"],
].map(([property, mapKey, label]) => {
    const records = dataset[property] ?? [];
    if (!Array.isArray(records)) {
        throw new TypeError(`Dataset ${dataset.title ?? dataset.uuid ?? "(untitled)"}: ${property} must be an array`);
    }
    return { property, fields: fieldMap[mapKey], label, records };
});

---
<section class="dataset-metadata">
    <h3 class="dataset-metadata__title">{dataset.title || "Untitled dataset"}</h3>
    <div class="dataset-metadata__body">
        <div class="dataset-metadata__overview">
            {hasDescription && <p><b>Description:</b> {dataset.description}</p>}
            {voxelSize && <p><b>{voxelSize.label}:</b> {voxelSize.value}</p>}
            <p><b>Number of images/files:</b> {fileCount ?? "Not reported"}</p>
            {fileFormats && <p><b>{fileFormatsLabel}:</b> {fileFormats}</p>}
        </div>
        {groups.filter(group => group.records.length > 0).map(group => (
            <section class="dataset-metadata__group" data-metadata-group={group.property}>
                <h4 class="dataset-metadata__group-title">{group.label}</h4>
                {group.records.map(record => (
                    <DatasetMetadataRecord data={record} fieldMap={group.fields} />
                ))}
            </section>
        ))}
    </div>
</section>
