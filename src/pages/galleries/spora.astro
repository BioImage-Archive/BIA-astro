---
import BaseLayout from '../../layouts/BaseLayoutWithBreadcrumbs.astro';
import MenuCard from "../../components/cards/LandingPageMenuCard.astro";

const cards = [
  {
    label: "Dataset Browser",
    description: "Browse, filter, and download all 31 cohorts by cancer type, technology, and more.",
    target: "/bioimage-archive/galleries/spora/dataset",
  },
  {
    label: "Explore Tissue Data",
    description: "Explore every cohort in spora through an interactive multiplex visualizer with multi-channel overlays, right in your browser.",
    target: "http://172.22.68.190:8000/visualizer.html",
  },
];

---
<BaseLayout pageTitle="SPORA">
  <section class="vf-content vf-u-fullbleed spora-shell">
    <div class="vf-content">
      <div class="vf-grid vf-grid__col-2">
        <div class="spora-media-panel" aria-hidden="true">
          <div class="spora-media">
            <img src="/src/assets/bioimage-archive/spora_landing_page.jpg" alt="" />
          </div>
        </div>

        <div class="vf-stack vf-stack--400 spora-copy">
          <a class="vf-link spora-brand" href="/bioimage-archive/galleries/spora" aria-label="SPORA home" style="text-decoration: none;color: #3b6fb6;">
            <span>[</span> spora <span>]</span>
          </a>
          <p class="spora-kicker">Spatial Proteomics Dataset</p>
          <h1 class="vf-text vf-text-heading--1">AI ready spatial proteomics dataset</h1>
          <p class="vf-text-body vf-text-body--2 spora-description">
            Download and explore standardized multiplexed imaging data to understand tissue architecture
            across cancer types and organs with SPORA.
          </p>
          <dl class="vf-grid spora-stats" aria-label="SPORA dataset summary">
            <div class="spora-stat">
              <dt>MX Images</dt>
              <dd>12,596</dd>
            </div>
            <div class="spora-stat">
              <dt>Patients</dt>
              <dd>5,254</dd>
            </div>
            <div class="spora-stat">
              <dt>Cohorts</dt>
              <dd>31</dd>
            </div>
            <div class="spora-stat">
              <dt>Technologies</dt>
              <dd>4</dd>
            </div>
          </dl>
          <div><p class="spora-attribution__label">A project by:</p></div>
          <div class="spora-attribution" aria-label="Project attribution">
            <div class="spora-attribution__partners">
              <span class="spora-attribution__partner"><a href="https://aimm.epfl.ch/" target="_blank" class="vf-link"><img style="background-color: black; height:3.5em;padding:0.25em;" src="/src/assets/bioimage-archive/AIPM_PNG.png" alt="AIMM Logo"/></a></span>
              <span class="spora-attribution__partner"><a href="https://www.epfl.ch/" target="_blank" class="vf-link"><img style="background-color: black;height:3.5em;padding:0.25em;" src="/src/assets/bioimage-archive/logo-epfl.png" alt="EPFL Logo"/></a></span>
            </div>
          </div>
          <div>
            <h2>Diverse Data Collection</h2>
            <p class="vf-text-body vf-text-body--2">
              SPORA spans 31 cohorts across CRC, TNBC, NSCLC, Lymphoma, Melanoma, PDAC, and more, captured across IMC, CODEX, Orion, and MIBI platforms.
            </p>
          </div>
        </div>
    </div>
  </section>
  <section
    class="vf-grid vf-grid__col-2 | vf-card-container | vf-u-fullbleed"
  >
    {
      cards.map((card) => (
        <MenuCard
          label={card.label}
          description={card.description}
          target={card.target}
        />
      ))
    }
  </section>
</BaseLayout>
<style>
  .spora-shell {
    --spora-ink: #0f1720;
    --spora-muted: #546170;
    --spora-line: #d6dde3;
    --spora-paper: #f7faf8;
    --spora-accent: #2f7d67;
    --spora-strong: #3b6fb6;
    --spora-mono: "IBM Plex Mono", "Courier New", monospace;
    padding-block: 0.5rem 0.5rem;
  }

  .spora-content {
    max-width: var(--vf-content-max-width, 1200px);
  }

  .spora-hero {
    align-items: center;
    gap: 0.5rem;
  }

  .spora-media-panel,
  .spora-copy {
    min-width: 0;
  }

  .spora-media {
    aspect-ratio: 1 / 1;
    width: min(100%, 34rem);
  }

  .spora-copy {
    padding-block: 1rem;
  }

  .spora-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    color: var(--spora-ink);
    font: 800 1.35rem/1 var(--spora-mono);
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: lowercase;
    white-space: nowrap;
  }

  .spora-brand span {
    color: var(--spora-accent);
  }


  .spora-stat dt {
    margin: 0 0 0.45rem;
    color: var(--spora-muted);
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .spora-stat dd {
    margin: 0;
    color: var(--spora-strong);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .spora-attribution {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }


  .spora-attribution__partner {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.75rem;
    line-height: 1;
  }

</style>