---
import Layout from '../../layouts/BiologicalVisionsLayout.astro';
import artworks from '../../data/collections/biological-visions.json';
---
<Layout>
  <header class="masthead">
    <a class="brand" href="/bioimage-archive/"><img src="/bioimage-archive/BIA-logo.svg" width="30" height="30" alt="" /><span>BioImage Archive</span></a>
    <a class="back" href="/bioimage-archive/galleries">All galleries <span aria-hidden="true">↗</span></a>
  </header>
  <main id="main">
    <section class="intro">
      <p class="eyebrow">Science, seen differently</p>
      <h1>Biological<br /><em>Visions.</em></h1>
      <div class="intro-bottom"><p>Extraordinary images of ordinary life.<br />Look closer at the worlds within us.</p><span class="collection-label">A collection from the BioImage Archive</span></div>
    </section>
    <section class:list={['artworks', { single: artworks.length === 1 }]} aria-label="Artworks">
      {artworks.map((artwork, index) => (
        <article id={artwork.slug}>
          <a class="artwork-link" href={`/bioimage-archive/galleries/biological-visions/${artwork.slug}`} aria-label={`Explore ${artwork.title} by ${artwork.creator}`}>
            <div class="image-wrap">
              <img src={artwork.preview} srcset={artwork.previews.map(p => `${p.uri} ${p.width}w`).join(', ')} sizes="(max-width: 700px) 90vw, (max-width: 1440px) 43vw, 620px" width={artwork.width} height={artwork.height} alt={artwork.alt} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />
              <span class="explore">Explore image <span aria-hidden="true">↗</span></span>
            </div>
          </a>
          <div class="artwork-info"><div><p class="number">{String(index + 1).padStart(2, '0')} / Biological Visions - {artwork.accession}</p><h2><a href={`/bioimage-archive/galleries/biological-visions/${artwork.slug}`}>{artwork.title}</a></h2><p class="credit">{artwork.creator}<span> · {artwork.affiliation}</span></p></div><p class="caption">{artwork.caption}</p></div>
        </article>
      ))}
    </section>
    <footer><p>Behind every image, a story of discovery.</p><a href="/bioimage-archive/galleries">Explore more collections <span aria-hidden="true">↗</span></a></footer>
  </main>
</Layout>
<style>
  .masthead { max-width:1440px;margin:auto;display:flex;align-items:center;justify-content:space-between;padding:28px 5vw;border-bottom:1px solid var(--line); }
  .brand { display:flex;align-items:center;gap:12px;font-size:16px;font-weight:600;text-decoration:none;letter-spacing:-.3px; }
  .brand img { border-radius:2px; }
  .back { font-size:13px;color:var(--muted);text-decoration:none; }.back span { margin-left:16px; }
  main { max-width:1440px;margin:auto; }.intro { padding:76px 5vw 60px; }
  .eyebrow,.number,.collection-label { text-transform:uppercase;font-size:10px;font-weight:500;letter-spacing:2px; }.eyebrow { color:var(--accent);margin:0 0 26px; }
  h1 { font-family:Georgia,'Times New Roman',serif;font-size:clamp(68px,9.4vw,134px);line-height:.94;letter-spacing:-5px;font-weight:400;margin:0; } h1 em { font-weight:400;color:var(--accent); }
  .intro-bottom { margin-top:34px;display:flex;align-items:flex-end;justify-content:space-between;gap:24px; }.intro-bottom p { font-size:17px;line-height:1.65;color:var(--muted);margin:0; }.collection-label { color:var(--muted);text-align:right;line-height:1.8; }
  .artworks { padding:0 5vw;display:grid;grid-template-columns:1fr 1fr;gap:60px 32px; }.artworks.single { display:block; }.artworks.single article { max-width:1080px; }
  .image-wrap { position:relative;overflow:hidden;background:#080a0a; }.image-wrap img { display:block;width:100%;height:auto; }.single .image-wrap img { max-height:88vh;object-fit:contain; }
  .artwork-link { display:block; }.explore { position:absolute;bottom:24px;right:24px;display:flex;align-items:center;gap:40px;background:rgba(16,19,19,.84);padding:16px 20px;border:1px solid #a9b1ab66;border-radius:2px;font-size:12px;backdrop-filter:blur(10px);transition:background .2s; }.artwork-link:hover .explore { background:var(--accent);color:var(--bg); }
  .artwork-info { padding-top:24px;display:block; }.single .artwork-info { display:flex;justify-content:space-between;gap:40px; }.number { color:var(--muted);margin:0 0 12px; }h2 { font-size:28px;font-weight:400;font-family:Georgia,'Times New Roman',serif;margin:0 0 10px; }h2 a { text-decoration:none; }.credit { font-size:12px;line-height:1.8;margin:0; }.credit span { color:var(--muted); }.caption { font-size:13px;line-height:1.8;color:var(--muted);max-width:540px;margin:18px 0 0; }
  footer { margin:90px 5vw 0;padding:30px 0 42px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:24px;color:var(--muted);font-size:12px; }footer p { margin:0; }footer a { text-decoration:none; }
  @media(max-width:700px) { .masthead { padding:20px 5vw; }.brand { font-size:14px; }.back { font-size:11px; }.intro { padding-top:54px; }h1 { letter-spacing:-3px; }.intro-bottom { display:block; }.collection-label { display:none; }.artworks { display:block; }.artwork-info { display:block; }.caption { margin-top:18px; }.explore { bottom:14px;right:14px;padding:12px 16px; }.artworks article { margin-bottom:48px; }footer { margin-top:56px;display:block; }footer a { display:block;margin-top:18px; } }
</style>
